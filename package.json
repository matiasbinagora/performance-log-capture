{
  "name": "performance-log-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src scripts/performance-dashboard.ts scripts/performance-run.ts tests vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "performance:run": "tsx scripts/performance-run.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "openspec:validate": "openspec validate performance-log-capture --strict",
    "dashboard:generate": "tsx scripts/performance-dashboard.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "graphify:index": "node scripts/graphify-project.mjs index",
    "graphify:search": "node scripts/graphify-project.mjs search",
    "graphify:inspect": "node scripts/graphify-project.mjs inspect",
    "log-analysis": "tsx scripts/log-analysis.ts",
    "start": "node dist/src/server.js",
    "openspec:validate": "openspec validate performance-log-capture --strict"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
